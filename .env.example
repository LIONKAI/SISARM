# ══════════════════════════════════════════════════════════════════════
#  SISARM — Plantilla de variables de entorno
#  
#  INSTRUCCIONES:
#  1. Copie este archivo y renómbrelo a ".env" (sin la extensión .example)
#  2. Complete los valores entre <CORCHETES>
#  3. NUNCA suba el archivo .env real al repositorio
# ══════════════════════════════════════════════════════════════════════


# ── Django ────────────────────────────────────────────────────────────
# Clave secreta de Django. En producción debe ser un valor aleatorio y
# único. Puede generar uno nuevo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-cambiar-en-produccion

# Modo de depuración. True solo para desarrollo local.
DEBUG=True

# Hosts permitidos, separados por coma. En local basta con *.
ALLOWED_HOSTS=*


# ── Base de datos PostgreSQL ──────────────────────────────────────────
# Para ejecutar en local, deje la siguiente línea comentada con # adelante.
# Django usará automáticamente la configuración local del settings.py
# (host=localhost, user=postgres, password=dorolan3, db=sisarm_db).
#
# Si tiene su propia BD remota, descomente y reemplace con su URL:
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd


# ── Email — Gmail SMTP ────────────────────────────────────────────────
# Para que funcione la recuperación de contraseña (HU 1.2) se necesita:
#   1. Una cuenta Gmail con verificación en 2 pasos activada.
#   2. Una "contraseña de aplicación" generada en:
#      https://myaccount.google.com/apppasswords
#
# Coloque la contraseña de aplicación SIN ESPACIOS (16 caracteres).
EMAIL_HOST_USER=<su-correo>@gmail.com
EMAIL_HOST_PASSWORD=<contraseña-de-aplicacion-sin-espacios>


# ── Frontend ──────────────────────────────────────────────────────────
# URL del frontend, usada para construir el enlace del email de
# recuperación. En local mantenga el valor por defecto.
FRONTEND_URL=http://localhost:5173