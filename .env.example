# ======================================================================
#  SISARM - Plantilla de variables de entorno
#
#  INSTRUCCIONES:
#  1. Copie este archivo y renombrelo a ".env" (sin la extension .example)
#  2. Complete los valores entre <CORCHETES>
#  3. NUNCA suba el archivo .env real al repositorio
# ======================================================================


# -- Django -----------------------------------------------------------
# Clave secreta de Django. En produccion debe ser un valor aleatorio y
# unico. Puede generar uno nuevo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-cambiar-en-produccion

# Modo de depuracion. True solo para desarrollo local.
DEBUG=True

# Hosts permitidos, separados por coma. En local basta con *.
ALLOWED_HOSTS=*


# -- Base de datos PostgreSQL -----------------------------------------
# Para ejecutar en local, deje la siguiente linea comentada con # adelante.
# Django usara automaticamente la configuracion local del settings.py
# (host=localhost, user=postgres, password=dorolan3, db=sisarm_db).
#
# Si tiene su propia BD remota, descomente y reemplace con su URL:
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd


# -- Email - Gmail SMTP -----------------------------------------------
# Para que funcione la recuperacion de contrasena (HU 1.2) se necesita:
#   1. Una cuenta Gmail con verificacion en 2 pasos activada.
#   2. Una "contrasena de aplicacion" generada en:
#      https://myaccount.google.com/apppasswords
#
# Coloque la contrasena de aplicacion SIN ESPACIOS (16 caracteres).
EMAIL_HOST_USER=<su-correo>@gmail.com
EMAIL_HOST_PASSWORD=<contrasena-de-aplicacion-sin-espacios>


# -- Frontend ---------------------------------------------------------
# URL del frontend, usada para construir el enlace del email de
# recuperacion. En local mantenga el valor por defecto.
FRONTEND_URL=http://localhost:5173


# -- Asistente IA - Google Gemini -------------------------------------
# Necesario para la HU 4.1 (Epica 4) - Asistente conversacional con
# acceso a la base de datos del arancel mediante function calling.
# Esta HU consolida SIS-26 (clasificar), SIS-27 (resumir notas) y
# SIS-14 (comparar partidas) en una sola interfaz de chat.
#
# Como obtener una API key (gratis):
#   1. IMPORTANTE: use una cuenta Gmail PERSONAL (no @unifranz.edu.bo ni
#      otras cuentas institucionales). Las cuentas de organizacion
#      tienen restricciones que bloquean el tier gratuito de Gemini.
#   2. Vaya a https://aistudio.google.com/apikey
#   3. Inicie sesion con su cuenta Gmail personal.
#   4. Clic en "Create API key" -> "Create API key in new project".
#   5. Copie el valor generado (empieza con "AIza...") y peguelo abajo.
#
# Si esta variable no esta configurada, el chat de IA devolvera
# error 503 pero el resto del sistema (busqueda, explorador, favoritos,
# historial, etc.) sigue funcionando normalmente.
GEMINI_API_KEY=<su-api-key-de-google-aistudio>

# Opcional: modelo Gemini a usar. Por defecto usa gemini-2.5-flash.
# Si su key/proyecto no soporta ese modelo, pruebe alternativas:
#   gemini-2.0-flash, gemini-flash-latest, gemini-1.5-flash
# Deje comentado para usar el default.
# GEMINI_MODEL=gemini-2.5-flash
